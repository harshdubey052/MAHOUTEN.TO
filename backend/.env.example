# ========================================================
# Mahouten.to Backend Production Environment Variables
# ========================================================

# Django Secret Key (generate a secure random 50-char string in production)
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-here

# Debug Mode (set to False in production)
DEBUG=False

# Allowed Hosts (comma-separated or * for any)
ALLOWED_HOSTS=*

# --------------------------------------------------------
# MongoDB Atlas Connection String
# --------------------------------------------------------
# Get this from https://cloud.mongodb.com -> Connect -> Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_user:your_password@cluster0.abcde.mongodb.net/mahouten_db?retryWrites=true&w=majority
MONGO_DB_NAME=mahouten_db

# --------------------------------------------------------
# Automated Administrator Provisioning (Optional)
# If provided, an admin account will automatically be created/updated on first startup
# --------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_USERNAME=admin

# --------------------------------------------------------
# Cloudinary Media Storage (Required for persistent uploads on Render)
# Get credentials from https://cloudinary.com/console
# --------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Alternatively, set the single CLOUDINARY_URL format:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) & Frontend
# --------------------------------------------------------
# Add your production Vercel deployment URL here:
CORS_ALLOWED_ORIGINS=https://mahouten.vercel.app,http://localhost:5173
