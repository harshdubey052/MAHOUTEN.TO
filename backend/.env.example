# ========================================================
# Mahouten.to Backend Production Environment Variables
# ========================================================

# Django Secret Key (generate a secure random 50-char string in production)
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-here

# Debug Mode (set to False in production)
DEBUG=False

# Allowed Hosts (comma-separated or * for any)
ALLOWED_HOSTS=*

# MongoDB Atlas Connection String
# Get this from https://cloud.mongodb.com -> Connect -> Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin:yourpassword@cluster0.abcde.mongodb.net/mahouten_db?retryWrites=true&w=majority

# Database name
MONGO_DB_NAME=mahouten_db
